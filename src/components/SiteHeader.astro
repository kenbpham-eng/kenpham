          <video id="project-hover-video" style="max-width:40vw;max-height:80vh;border-radius:12px;background:#000;display:none;box-shadow:0 8px 32px #000a;" muted loop></video>
          <div id="project-hover-overlay" style="display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#fff;background:rgba(0,0,0,0.7);padding:18px 32px;border-radius:8px;font-size:1.3rem;font-weight:600;letter-spacing:1px;text-align:center;z-index:10;pointer-events:none;"></div>
