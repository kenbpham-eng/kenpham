      <div class="projects-section">
        <h3>LINKS</h3>
        <a href="https://www.imdb.com/name/nm7730137/" target="_blank" rel="noopener noreferrer">IMDB</a>
      </div>
      <div id="project-video-preview" style="display:none;position:fixed;top:0;right:0;height:100vh;z-index:9999;justify-content:center;align-items:center;background:transparent;pointer-events:none;transition:opacity 0.2s;">
        <div id="project-video-bg" style="position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);"></div>
