        <a href="#" data-video="bmwm4gt4_hover.mp4">BMW M4 GT4 <span class="status">(2025)</span></a>
        <a href="#" data-video="cayenne2024_hover.mp4">Porsche Cayenne Campaign <span class="status">(2024)</span></a>
        <a href="#" data-video="driveyourownpath_hover.mp4">Policaro Group Drive Your Own Path <span class="status">(2024)</span></a>
        <a href="#" data-video="pckw_hover.mp4">Porsche PCKW Opening <span class="status">(2023)</span></a>
        <a href="#" data-video="pecdakar_hover.mp4">PEC Porsche 911 Dakar <span class="status">(2023)</span></a>
        <a href="#" data-video="myporscheapp_hover.mp4">My Porsche App <span class="status">(2023)</span></a>
        <a href="#" data-video="driveyourownpath_hover.mp4">Porsche Taycan EV Roadtrip <span class="status">(2023)</span></a>
        <a href="#" data-video="volvoawareness_hover.mp4">Volvo Awareness Campaign <span class="status">(2023)</span></a>
        <a href="#" data-video="vinfast_hover.mp4">VinFast Boundless Together <span class="status">(2022)</span></a>
