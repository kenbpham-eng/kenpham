      </div>
      <div class="social-section">
        <div class="social-icons">
          <a href="mailto:kenbpham@icloud.com" aria-label="Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m2 7 10 7 10-7"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/iamkenpham" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="18" cy="6" r="1"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div class="projects-toggle-row">
      <button class="projects-toggle" aria-label="Toggle projects menu">
        + VIEW PROJECT LIST
      </button>
    </div>
  </div>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header { 
    text-align: left;
    margin-bottom: 62.4px;
    padding: 41.6px 0;
    position: sticky;
    top: 0;
    z-index: 99;
    background: transparent;
    backdrop-filter: none;
    transition: opacity 0.3s ease;
  }
  .menu-toggle {
    display: none;
    position: absolute;
    top: 32px;
    right: 0;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 100;
  }
  .menu-toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #f2f2f2;
    margin: 5px 0;
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform-origin: center;
  }
  .menu-toggle.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle.active span:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  .menu-close {
    display: none;
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: #ffffff;
    font-size: 40px;
    line-height: 1;
    transition: color 0.2s ease;
    z-index: 102;
  }
  .menu-close:hover {
    color: #ccc;
  }
  .menu-close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }
  .main-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 0;
    display: flex;
    gap: 32px;
    align-items: center;
    z-index: 100;
  }
  .main-nav a {
    color: rgba(242, 242, 242, 0.6);
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.3px;
    transition: color 0.2s ease;
    text-transform: lowercase;
    position: relative;
  }
  .main-nav a::before,
  .main-nav a .underline {
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 100%;
    height: 1px;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s ease;
  }
  .main-nav a:hover,
  .main-nav a:focus-visible {
    color: #555555;
    outline: none;
  }
  .main-nav a:hover .underline,
  .main-nav a:focus-visible .underline {
    transform: scaleX(1);
  }
  .main-nav a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 2px;
  }
  .main-nav a.active {
    color: #f2f2f2;
  }
  .main-nav a.active .underline {
    transform: scaleX(1);
  }
  
  @media (max-width: 768px) {
    .main-nav a.active {
      color: #000000;
    }
    .main-nav a.active .underline {
      background: #000000;
    }
  }
  .site-header h1 {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #f2f2f2;
    font-family: var(--font-heading);
    font-size: 35px;
  }
  .site-header h1 a {
    color: #f2f2f2;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .site-header h1 a:hover { opacity: 0.7; }
  .site-header h1 a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }
  .header-content { display: flex; flex-direction: column; align-items: flex-start; gap: 0; width: 100%; }
  .header-row { display: flex; flex-direction: row; align-items: center; width: 100%; gap: 32px; }
  .name-section { display: flex; flex-direction: column; }
  .social-section { display: flex; align-items: center; }
  .projects-toggle-row { display: flex; width: 100%; margin-top: 8px; justify-content: flex-start; }
  .projects-toggle { margin-left: 0; }
  .name-section { display: flex; flex-direction: column; }
  .name-section h1 { margin: 0; }
  .name-section h2 { margin: 8px 0 0 0; font-weight: 400; letter-spacing: 0.2px; color: #f2f2f2; font-family: var(--font-heading); font-size: inherit; }
  .social-section { }
  .social-icons { display: flex; gap: 12px; align-items: center; }
  .social-icons a, .social-icons svg { color: rgba(242, 242, 242, 0.6); }
  .social-icons a:hover, .social-icons a:focus { color:#fff; outline:none; filter: drop-shadow(0 0 2px #fff2); }
  .social-icons a:hover svg, .social-icons a:focus svg { color: #fff; }
  .social-icons a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }
  .social-icons svg { width: 20px; height: 20px; }
  :global(h1), :global(h2), :global(h3), :global(h4), :global(h5), :global(h6) {
    font-family: var(--font-heading);
    font-weight: 400;
    margin: 0 0 0.5em 0;
  }

  /* Heading scale inspired by GrandArmy */
  :global(h1) { font-size: 2.125rem; line-height: 1.1; letter-spacing: 0; }
  :global(h2) { font-size: 1.7rem; line-height: 1.35; }
  :global(h3) { font-size: 1.5rem; line-height: 1.3; }
  :global(h4) { font-size: 1.125rem; line-height: 1.25; }

  @media (min-width: 37.5em) {
    :global(h1) { font-size: 2.5rem; }
    :global(h2) { font-size: 2.0rem; }
    :global(h3) { font-size: 1.6rem; }
  }
  @media (min-width: 50em) {
    :global(h1) { font-size: 2.875rem; }
    :global(h2) { font-size: 2.57143rem; }
    :global(h3) { font-size: 1.6rem; }
  }
  @media (min-width: 75em) {
    :global(h1) { font-size: 3.125rem; }
    :global(h1.h1-display) { font-size: 4.75rem; line-height: 1.05; }
    :global(h2) { font-size: 2.85714rem; }
  }

  @media (max-width: 768px) {
    .site-header { text-align: center; padding: 24px 16px; margin-bottom: 32px; }
    .site-header h1 { font-size: 24px; margin: 0; text-align: left; }
    .site-header h2 { font-size: 13px; margin: 4px 0 0 0; text-align: left; }
    .header-content { 
      flex-direction: column; 
      gap: 12px; 
      margin: 0; 
      align-items: flex-start;
      justify-content: center;
    }
    .name-section {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .social-section {
      display: flex;
      align-items: center;
    }
    .social-icons { gap: 16px; }
    .menu-toggle { display: block; }
    .menu-close { display: block; }
    .main-nav { 
      position: fixed; 
      top: 0; 
      right: -100%; 
      width: 70%; 
      height: 100vh; 
      background: #000000; 
      backdrop-filter: none;
      flex-direction: column; 
      justify-content: center; 
      align-items: center; 
      gap: 40px; 
      transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1); 
      z-index: 101;
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
      transform: none;
    }
    .main-nav.active { right: 0; }
    .main-nav a { 
      font-size: 20px;
      opacity: 0;
      transform: translateX(20px);
      transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
      color: #ffffff;
    }
    .main-nav.active a { 
      opacity: 1; 
      transform: translateX(0);
    }
    .main-nav.active a:nth-child(1) { transition-delay: 0.1s; }
    .main-nav.active a:nth-child(2) { transition-delay: 0.15s; }
    .main-nav.active a:nth-child(3) { transition-delay: 0.2s; }
    .main-nav.active a:nth-child(4) { transition-delay: 0.25s; }
  }

  /* Projects Drawer Styles */
  .projects-toggle {
    background: none;
    border: none;
    color: rgba(242, 242, 242, 0.6);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.3px;
    cursor: pointer;
    padding: 0;
    text-transform: lowercase;
    transition: color 0.2s ease;
    display: block;
  }

  .projects-toggle:hover,
  .projects-toggle:focus-visible {
    color: #fff;
    outline: none;
  }

  .projects-nav {
    position: fixed;
    top: 0;
    left: -100%;
    width: 50%;
    max-width: 340px;
    height: 100vh;
    background: #ffffff;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    z-index: 101;
    box-shadow: 4px 0 24px rgba(0, 0, 0, 0.15);
    transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
    overflow-x: hidden;
    padding-top: 60px;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .projects-nav.active {
    left: 0;
  }

  .projects-close {
    display: none;
    position: absolute;
    top: 24px;
    left: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: #000000;
    font-size: 40px;
    line-height: 1;
    transition: color 0.2s ease;
    z-index: 102;
  }

  .projects-nav.active .projects-close {
    display: block;
  }

  .projects-content {
    width: 100%;
    padding: 0 24px 48px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .projects-section {
    margin-bottom: 32px;
  }

  .projects-section h3 {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #000000;
    margin: 0 0 12px 0;
    text-align: left;
  }

  .projects-section a {
    display: block;
    color: #000000;
    text-decoration: none;
    font-size: 14px;
    line-height: 1.4;
    transition: opacity 0.2s ease;
    margin-bottom: 3px;
    text-align: left;
  }

  .projects-section a:hover {
    opacity: 0.6;
    text-decoration: underline;
  }

  .projects-section a .status {
    opacity: 0.6;
    font-size: 12px;
  }

  @media (max-width: 768px) {
    .projects-toggle {
      /* No override: always visible, consistent style */
    }

    .projects-toggle:hover,
    .projects-toggle:focus-visible {
      color: #555555;
    }

    .projects-close {
      display: block;
    }
  }
  #project-video-preview {
    display: flex;
    opacity: 1;
    pointer-events: auto;
    align-items: center;
    justify-content: flex-start;
    position: fixed;
    top: 0;
    right: 0;
    width: 50vw;
    height: 100vh;
    z-index: 9999;
    background: transparent;
    transition: opacity 0.2s;
  }
  #project-video-bg {
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: auto;
    z-index: 1;
  }
  #project-video-inner {
    pointer-events: none;
    z-index: 2;
  }
  #project-hover-video {
    pointer-events: none;
  }
  #project-video-inner video {
    box-shadow: 0 8px 32px #000a;
  }
  #project-video-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
  }
  #project-hover-video {
    max-width: 40vw;
    max-height: 80vh;
    border-radius: 12px;
    background: #000;
    display: none;
    pointer-events: none;
  }
</style>

<script is:inline>
  // Mobile menu toggle (scoped to this component)
  (function(){
    const root = document.currentScript?.closest('.site-header') || document.querySelector('.site-header');
    if (!root) return;
    const menuToggle = root.querySelector('.menu-toggle');
    const menuClose = root.querySelector('.menu-close');
    const nav = root.querySelector('.main-nav');
    if (menuToggle && nav) {
      menuToggle.addEventListener('click', (e) => {
        // Prevent any other click listeners on this element from running (avoids double-toggles if a page script also binds)
        if (e && typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
        nav.classList.toggle('active');
        menuToggle.classList.toggle('active');
      });
      if (menuClose) {
        menuClose.addEventListener('click', () => {
          nav.classList.remove('active');
          menuToggle.classList.remove('active');
        });
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('active')) {
          nav.classList.remove('active');
          menuToggle.classList.remove('active');
        }
      });
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.site-header')) {
          nav.classList.remove('active');
          menuToggle.classList.remove('active');
        }
      });
      nav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          nav.classList.remove('active');
          menuToggle.classList.remove('active');
        });
      });
    }
  })();

  // Highlight active navigation link
  (function() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('.main-nav a');
    
    navLinks.forEach(link => {
      const href = link.getAttribute('href');
      // Check if current page matches the link (exact match or starts with for subpages)
      if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
        link.classList.add('active');
      }
    });
  })();

  // Projects drawer toggle
  (function(){
    const root = document.currentScript?.closest('.site-header') || document.querySelector('.site-header');
    if (!root) return;
    const projectsToggle = root.querySelector('.projects-toggle');
    const projectsToggleSubtitle = root.querySelector('.projects-toggle-subtitle');
    const projectsClose = root.querySelector('.projects-close');
    const projectsNav = root.querySelector('.projects-nav');
    const projectsOverlay = root.querySelector('.projects-overlay');

    function openProjectsDrawer() {
      projectsNav.classList.add('active');
      if (projectsOverlay) projectsOverlay.classList.add('active');
    }
    function closeProjectsDrawer() {
      projectsNav.classList.remove('active');
      if (projectsOverlay) projectsOverlay.classList.remove('active');
    }

    if (projectsToggle && projectsNav) {
      projectsToggle.addEventListener('click', openProjectsDrawer);
    }
    if (projectsToggleSubtitle && projectsNav) {
      projectsToggleSubtitle.addEventListener('click', openProjectsDrawer);
    }
    if (projectsClose && projectsNav) {
      projectsClose.addEventListener('click', closeProjectsDrawer);
    }
    if (projectsOverlay) {
      projectsOverlay.addEventListener('click', closeProjectsDrawer);
    }
    if (projectsNav) {
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && projectsNav.classList.contains('active')) {
          closeProjectsDrawer();
        }
      });
      projectsNav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', closeProjectsDrawer);
      });
    }
  })();
  // Project video preview background always visible when drawer is open; video only on hover
  (function() {
    const projectsNav = document.querySelector('.projects-nav');
    const videoPreview = document.getElementById('project-video-preview');
    const videoEl = document.getElementById('project-hover-video');
    const videoInner = document.getElementById('project-video-inner');
    const videoBg = document.getElementById('project-video-bg');
    if (!projectsNav || !videoPreview || !videoEl || !videoInner || !videoBg) return;
    function getDrawerWidth() {
      const drawer = document.querySelector('.projects-nav');
      if (!drawer) return 0;
      return drawer.getBoundingClientRect().width;
    }
    function positionPreview() {
      const drawerWidth = getDrawerWidth();
      videoPreview.style.left = drawerWidth + 'px';
      videoPreview.style.right = '0';
      videoPreview.style.width = `calc(100vw - ${drawerWidth}px)`;
    }
    // Show/hide preview background with drawer
    function showPreviewBg() {
      positionPreview();
      videoPreview.style.display = 'flex';
      videoPreview.style.opacity = '1';
    }
    function hidePreviewBg() {
      videoPreview.style.display = 'none';
      videoPreview.style.opacity = '0';
      videoEl.pause();
      videoEl.removeAttribute('src');
      videoEl.load();
      videoEl.style.display = 'none';
    }
    // Listen for drawer open/close
    const observer = new MutationObserver(() => {
      if (projectsNav.classList.contains('active')) {
        showPreviewBg();
      } else {
        hidePreviewBg();
      }
    });
    observer.observe(projectsNav, { attributes: true, attributeFilter: ['class'] });
    window.addEventListener('resize', positionPreview);
    // Video on hover only
    let lastHoveredLink = null;
    const hoverOverlay = document.getElementById('project-hover-overlay');
    projectsNav.querySelectorAll('a[data-video]').forEach(link => {
      const videoFile = link.getAttribute('data-video');
      const overlayText = link.getAttribute('data-overlay');
      if (!videoFile) return;
      link.addEventListener('mouseenter', () => {
        if (lastHoveredLink !== link) {
          videoEl.pause();
          videoEl.removeAttribute('src');
          videoEl.load();
        }
        videoEl.src = `/media/${videoFile}`;
        videoEl.currentTime = 0;
        videoEl.play();
        videoEl.style.display = 'block';
        if (overlayText) {
          hoverOverlay.textContent = overlayText;
          hoverOverlay.style.display = 'block';
        } else {
          hoverOverlay.style.display = 'none';
        }
        lastHoveredLink = link;
      });
      link.addEventListener('mouseleave', () => {
        videoEl.pause();
        videoEl.removeAttribute('src');
        videoEl.load();
        videoEl.style.display = 'none';
        hoverOverlay.style.display = 'none';
        lastHoveredLink = null;
      });
    });
    // Hide video and close drawer if background is clicked
    // Make background clickable to close drawer (not the video)
    videoBg.addEventListener('click', () => {
      videoEl.pause();
      videoEl.removeAttribute('src');
      videoEl.load();
      videoEl.style.display = 'none';
      lastHoveredLink = null;
      projectsNav.classList.remove('active');
    });
  })();
</script>
