---
// ProjectModal.astro - Lightweight modal component for project galleries
// No SSR data loading - uses JSON and vanilla JS for interactivity
---

<div id="project-modal" class="modal-overlay" role="dialog" aria-hidden="true">
  <!-- Loading Spinner -->
  <div class="modal-loading" id="modal-loading">
    <div class="spinner"></div>
  </div>

  <!-- Swipe indicator for mobile -->
  <div class="swipe-indicator" id="swipe-indicator">
    <span class="swipe-arrow left">‹</span>
    <span class="swipe-text">Swipe to navigate</span>
    <span class="swipe-arrow right">›</span>
  </div>

  <div class="modal-content">
    <div class="pull-indicator"></div>
    <button class="modal-close" aria-label="Close modal">
      <span>×</span>
    </button>
    
    <div class="modal-body">
      <div class="modal-header">
        <div class="title-row">
          <h2 id="modal-title"></h2>
          <button id="modal-theme-toggle" class="theme-toggle" aria-label="Toggle dark or light theme" aria-pressed="false" type="button">
            <span class="switch" aria-hidden="true">
              <span class="thumb"></span>
            </span>
          </button>
        </div>
        <div class="modal-metadata" id="modal-metadata"></div>
      </div>

      <div class="modal-video-section">
        <video
          id="modal-video"
          class="modal-video"
          loop
          muted
          playsinline
          preload="none"
          aria-label="Project video"
          style="display: none;">
        </video>
        <img 
          id="modal-image"
          class="modal-image" 
          style="display: none;"
          alt="Project image">
      </div>

      <div class="modal-description" id="modal-description"></div>

      <div id="modal-featuring" class="modal-featuring" style="display: none;">
        <div class="featuring-label" id="featuring-label"></div>
        <div class="featuring-names" id="featuring-names"></div>
        <div class="featuring-laurel" id="featuring-laurel"></div>
      </div>

      <div id="modal-credits" class="modal-credits" style="display: none;">
        <h3>CREDITS</h3>
        <div class="credits-list" id="credits-list"></div>
      </div>

      <div id="modal-awards" class="modal-awards" style="display: none;">
        <h3>AWARDS</h3>
        <div class="awards-list" id="awards-list"></div>
      </div>

      <div id="modal-press" class="modal-press" style="display: none;">
        <h3>PRESS</h3>
        <div class="press-list" id="press-list"></div>
      </div>

      <div id="modal-gallery" class="modal-gallery" style="display: none;">
        <h3>STILLS</h3>
        <div class="gallery-grid" id="gallery-grid"></div>
      </div>
    </div>
  </div>
</div>

<!-- Lightbox overlay for enlarged stills -->
<div id="lightbox-overlay" class="lightbox-overlay" aria-hidden="true" style="display:none;">
  <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
  <img id="lightbox-image" alt="Preview" />
  <button id="lightbox-prev" class="lightbox-prev" aria-label="Previous">‹</button>
  <button id="lightbox-next" class="lightbox-next" aria-label="Next">›</button>
</div>

<style is:global>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* Loading Spinner */
  .modal-loading {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1010;
  }

  .modal-loading.visible {
    display: flex;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Swipe Indicator */
  .swipe-indicator {
    display: none;
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    padding: 10px 20px;
    border-radius: 20px;
    font-size: 13px;
    z-index: 1050;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .swipe-indicator.visible {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 1;
  }

  .swipe-arrow {
    font-size: 18px;
    animation: swipePulse 1.5s ease-in-out infinite;
  }

  .swipe-arrow.left {
    animation-delay: 0s;
  }

  .swipe-arrow.right {
    animation-delay: 0.75s;
  }

  @keyframes swipePulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Pull-to-close indicator */
  .pull-indicator {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 4px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 2px;
    z-index: 1002;
    display: none;
  }

  @media (max-width: 768px) {
    .pull-indicator {
      display: block;
    }
  }

  .modal-content.modal-dark .pull-indicator {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Modal dragging state */
  .modal-content.dragging {
    transition: none !important;
  }

  .modal-content.closing {
    animation: slideOutRight 0.3s ease forwards;
  }

  @keyframes slideOutRight {
    from { transform: translateX(0); }
    to { transform: translateX(100%); }
  }

  .modal-content {
    position: relative;
    width: 90%;
    max-width: 100%;
    height: 100%;
    background: #F7F7F7;
    padding: 32px 24px;
    animation: slideInRight 0.4s ease;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    margin-left: auto;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .modal-content {
      width: 50%;
      max-width: 50vw;
      padding: 32px 28px;
    }
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .modal-overlay.active .modal-content {
    animation: slideInRight 0.4s ease forwards;
  }

  .modal-close {
    position: sticky;
    top: 20px;
    float: right;
    background: none;
    border: none;
    color: #000000;
    font-size: 32px;
    cursor: pointer;
    z-index: 1001;
    transition: opacity 0.2s;
    padding: 8px;
    margin: -8px -8px 20px 0;
  }

  .modal-close:hover {
    opacity: 0.6;
  }

  /* Header layout */
  .modal-header { margin-bottom: 32px; margin-top: 10px; }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Simple pill toggle */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    user-select: none;
  }
  .theme-toggle .switch {
    position: relative;
    width: 32px;
    height: 16px;
    background: #F7F7F7;
    border: 2px solid #2F2F32;
    border-radius: 999px;
    padding: 2px;
    display: inline-flex;
    align-items: center;
  }
  .theme-toggle .thumb {
    width: 10px;
    height: 10px;
    background: #2F2F32;
    border-radius: 50%;
    transition: transform .3s cubic-bezier(.4,0,.2,1);
    transform: translateX(2px);
  }
  /* Light mode: thumb on left */
  .theme-toggle:not(.is-dark) .thumb { transform: translateX(2px); }
  /* Dark mode: thumb on right */
  .theme-toggle.is-dark .thumb { transform: translateX(16px); }

  /* Dark mode overrides */
  .modal-content.modal-dark { background: #000; }
  .modal-content.modal-dark .theme-toggle .switch { background: #2F2F32; border-color: #F7F7F7; }
  .modal-content.modal-dark .theme-toggle .thumb { background: #F7F7F7; }
  .modal-content.modal-dark .modal-close { color: #fff; }
  .modal-content.modal-dark #modal-title { color: #fff; }
  .modal-content.modal-dark .modal-metadata { color: rgba(255,255,255,0.7); }
  .modal-content.modal-dark .modal-year { color: rgba(255,255,255,0.6); }
  .modal-content.modal-dark .featuring-label { color: rgba(255,255,255,0.6); }
  .modal-content.modal-dark .featuring-names { color: #fff; }
  .modal-content.modal-dark .modal-description { color: #fff; }
  .modal-content.modal-dark .modal-description .description-label { color: rgba(255,255,255,0.6) !important; }
  .modal-content.modal-dark .modal-description .description-value { color: #fff !important; }
  .modal-content.modal-dark .modal-credits h3,
  .modal-content.modal-dark .modal-press h3,
  .modal-content.modal-dark .modal-awards h3,
  .modal-content.modal-dark .modal-gallery h3 { color: #fff; }
  .modal-content.modal-dark .credits-list { color: #fff !important; }
  .modal-content.modal-dark .credit-item { color: #fff !important; }
  .modal-content.modal-dark .credit-role { color: rgba(255,255,255,0.6) !important; }
  .modal-content.modal-dark .credit-name { color: #fff !important; }
  .modal-content.modal-dark .press-link { color: #fff; }
  .modal-content.modal-dark .press-link .underline { background: #fff; }
  .modal-content.modal-dark .featuring-laurel img { filter: none; }

  /* moved header spacing above */

  #modal-title {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.5px;
    word-break: break-word;
  }

  .modal-metadata {
    color: rgba(0, 0, 0, 0.7);
    font-size: 13px;
    letter-spacing: 0.3px;
    margin-top: 8px;
  }

  .modal-year {
    color: rgba(0, 0, 0, 0.6);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    display: none;
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .modal-video-section {
    aspect-ratio: 16 / 9;
    background: #000;
    overflow: clip;
    border: none;
    display: block;
    margin-left: -24px;
    margin-right: -24px;
    width: calc(100% + 48px);
  }

  .modal-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
    border: none;
    outline: none;
    display: block;
    transform: translateZ(0);
  }

  .modal-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #000;
    border: none;
    outline: none;
    display: block;
  }

  .modal-featuring {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 0px;
    margin-bottom: 24px;
  }

  .featuring-label {
    color: rgba(0, 0, 0, 0.6);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .featuring-names {
    color: #000000;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
  }

  .featuring-laurel {
    margin-top: 12px;
  }

  .featuring-laurel img {
    max-width: 30px;
    height: auto;
    display: block;
    filter: brightness(0) saturate(100%);
  }

  .featuring-laurel-img {
    max-width: 30px !important;
    height: auto !important;
    display: block !important;
    width: auto !important;
  }

  .modal-description {
    color: #000000;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 24px;
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 32px;
  }
  
  .modal-description p {
    grid-column: 1 / -1;
    margin: 0;
    line-height: 1.6;
  }

  .modal-description .description-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .modal-description .description-label {
    color: rgba(0, 0, 0, 0.6) !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .modal-description .description-value {
    color: #000000 !important;
    font-weight: 700;
    font-size: 14px;
  }

  .modal-credits h3,
  .modal-press h3,
  .modal-awards h3,
  .modal-gallery h3 {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 24px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .modal-credits {
    margin-bottom: 32px;
  }

  .modal-press {
    margin-bottom: 32px;
  }

  .modal-awards {
    margin-bottom: 32px;
  }

  .modal-gallery {
    margin-bottom: 32px;
  }

  .modal-gallery h3 {
    margin: 0 0 16px 0;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #000000;
  }

  .credits-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 32px;
    font-size: 13px;
    line-height: 1.5;
    color: #000000 !important;
  }

  .credit-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #000000 !important;
  }

  .credit-role {
    color: rgba(0, 0, 0, 0.6) !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
    display: block;
  }

  .credit-name {
    color: #000000 !important;
    font-weight: 700;
    font-size: 14px;
    display: block;
  }

  .press-list {
    font-size: 14px;
    line-height: 1.6;
  }

  .awards-list {
    font-size: 14px;
    line-height: 1.6;
  }
  .awards-list a {
    display: block;
    margin-bottom: 8px;
    white-space: normal;
  }

  .press-link {
    color: #000000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.3px;
    transition: opacity 0.2s ease;
    position: relative;
    display: inline-block;
    margin-bottom: 12px;
  }

  .press-link:hover {
    opacity: 0.7;
  }

  .press-link .underline {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: #000;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(.4,0,.2,1);
    pointer-events: none;
  }

  .press-link:hover .underline {
    transform: scaleX(1);
  }

  .gallery-grid {
    display: block;
    margin-top: 16px;
  }

  .gallery-grid img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    cursor: zoom-in;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      columns: 2;
      column-gap: 24px;
      column-fill: balance;
    }
    
    .gallery-grid img {
      break-inside: avoid;
      margin-bottom: 24px;
      display: inline-block;
      vertical-align: top;
    }
  }

  /* Lightbox */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
  }

  .lightbox-overlay.active { display: flex; }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    padding: 8px;
    cursor: pointer;
    z-index: 2001;
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: #fff;
    font-size: 40px;
    cursor: pointer;
    padding: 16px 20px;
    transition: background 0.2s;
    z-index: 2001;
  }

  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }

  .lightbox-prev:hover,
  .lightbox-next:hover { background: rgba(255,255,255,0.35); }

  #lightbox-image {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.45);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .modal-content {
      width: 95%;
      padding: 24px;
      margin: 20px auto;
    }

    .modal-close {
      top: 12px;
      right: 12px;
      font-size: 28px;
    }

    #modal-title {
      font-size: 20px;
    }

    /* Keep title and toggle on one line when space allows */
    .title-row { gap: 12px; }

    .modal-year {
      font-size: 12px;
    }

    .lightbox-prev,
    .lightbox-next {
      padding: 12px 16px;
      font-size: 28px;
    }
  }
</style>

<script define:vars={{ projectsUrl: '/data/projects.json' }}>
  let projectsData = null;
  let galleryLightboxIndex = 0;
  let currentGalleryImages = [];
  let modalInitialized = false;
  let modalElements = {};
  let lightboxOpen = false;
  let currentProjectIndex = 0;
  let projectIds = [];

  // Wait for DOM to be ready
  function initModal() {
    const modal = document.getElementById('project-modal');
    const modalContent = modal.querySelector('.modal-content');
    const modalLoading = document.getElementById('modal-loading');
    const swipeIndicator = document.getElementById('swipe-indicator');
    const isTouch = matchMedia("(hover: none) and (pointer: coarse)").matches;

    // Swipe gesture variables
    let touchStartX = 0;
    let touchStartY = 0;
    let touchCurrentX = 0;
    let isDragging = false;
    let isHorizontalSwipe = null;
    const modalClose = document.querySelector('.modal-close');
    const themeToggle = document.getElementById('modal-theme-toggle');
    const videoEl = document.getElementById('modal-video');
    const imageEl = document.getElementById('modal-image');
    const descriptionEl = document.getElementById('modal-description');
    const titleEl = document.getElementById('modal-title');
    const metadataEl = document.getElementById('modal-metadata');
    const featuringEl = document.getElementById('modal-featuring');
    const featuringLabelEl = document.getElementById('featuring-label');
    const featuringNamesEl = document.getElementById('featuring-names');
    const featuringLaurelEl = document.getElementById('featuring-laurel');
    const creditsEl = document.getElementById('modal-credits');
    const creditsList = document.getElementById('credits-list');
    const pressEl = document.getElementById('modal-press');
    const pressList = document.getElementById('press-list');
    const galleryEl = document.getElementById('modal-gallery');
    const galleryGrid = document.getElementById('gallery-grid');
    const lightbox = document.getElementById('lightbox-overlay');
    const lightboxImg = document.getElementById('lightbox-image');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    // Lazy load projects data
    async function loadProjects() {
      if (projectsData) return projectsData;
      try {
        const response = await fetch(projectsUrl);
        projectsData = await response.json();
        return projectsData;
      } catch (error) {
        console.error('Error loading projects:', error);
        return null;
      }
    }

    // Extract featuring line from description
    function extractFeaturing(description) {
      if (!description) return null;
      const lines = description.split('\n');
      const featuringLine = lines.find(line => line.trim().startsWith('Featuring:'));
      if (!featuringLine) return null;
      // Extract the names part after "Featuring:"
      const featuringText = featuringLine.trim();
      const names = featuringText.replace(/^Featuring:\s*/, '');
      return names;
    }

    // Parse credits from description (format: Role: Name\n)
    function parseCredits(description) {
      if (!description) return [];
      // Skip first 2 lines (synopsis and blank), then get lines with colons but not Featuring line
      const lines = description.split('\n').slice(2).filter(line => line.trim().includes(':') && !line.trim().startsWith('Featuring:'));
      return lines.map(line => {
        const [role, name] = line.split(':').map(s => s.trim());
        return { role, name };
      });
    }

    // Open modal with project data
    window.openProjectModal = async function(projectId, showLoading = true) {
      // Show loading spinner
      if (showLoading && modalLoading) {
        modalLoading.classList.add('visible');
      }

      const data = await loadProjects();
      if (!data) {
        if (modalLoading) modalLoading.classList.remove('visible');
        return;
      }

      // Build project IDs list for navigation
      projectIds = data.projects.map(p => p.id);
      currentProjectIndex = projectIds.indexOf(projectId);

      const project = data.projects.find(p => p.id === projectId);
      if (!project) {
        if (modalLoading) modalLoading.classList.remove('visible');
        return;
      }

      // Hide loading spinner
      if (modalLoading) {
        modalLoading.classList.remove('visible');
      }

      titleEl.textContent = project.title;
      if (project.metadata) {
        metadataEl.textContent = project.metadata;
      } else {
        metadataEl.textContent = '';
      }
      
      // Format description with label/value pairs
      const descLines = project.description.split('\n').slice(0, 2).filter(line => line.trim());
      descriptionEl.innerHTML = descLines.map(line => {
        if (line.includes(':')) {
          const [label, value] = line.split(':').map(s => s.trim());
          return `
            <div class="description-item">
              <span class="description-label">${label}</span>
              <span class="description-value">${value}</span>
            </div>
          `;
        }
        return `<p style="margin: 0; line-height: 1.6;">${line}</p>`;
      }).join('');

      // Handle featuring
      const featuringNames = extractFeaturing(project.description);
      // Check if project has laurel images
      let hasLaurel = false;
      if (projectId === 'thatwhichisheard') {
        featuringLaurelEl.innerHTML = '<img src="/portfolio/thatwhichisheard/DOCNYC25_Laurels_OfficialSelection_White.png" alt="DOC NYC 2025 Official Selection" loading="lazy" style="max-width: 150px; height: auto; display: block; width: auto;" />';
        hasLaurel = true;
      } else if (projectId === 'halfwaybroken') {
        featuringLaurelEl.innerHTML = '<img src="/portfolio/halfwaybroken/cropped-1.-TIMVF-logo-PNG.png" alt="Toronto International Motorcycle and Vehicle Festival" loading="lazy" style="max-width: 150px; height: auto; display: block; width: auto;" />';
        hasLaurel = true;
      } else if (projectId === 'thehallpass' && project.laurels && project.laurels.length > 0) {
        featuringLaurelEl.innerHTML = project.laurels.map(laurel => `<img src="${laurel.src}" alt="${laurel.alt}" loading="lazy" style="max-width: 150px; height: auto; display: inline-block; width: auto; margin-right: 12px;" />`).join('');
        hasLaurel = true;
      } else {
        featuringLaurelEl.innerHTML = '';
      }

      if (featuringNames) {
        featuringLabelEl.textContent = 'FEATURING';
        featuringNamesEl.textContent = featuringNames;
        featuringEl.style.display = 'flex';
      } else if (hasLaurel) {
        featuringLabelEl.textContent = '';
        featuringNamesEl.textContent = '';
        featuringEl.style.display = 'flex';
      } else {
        featuringEl.style.display = 'none';
      }

      // Load video or image lazily
      if (projectId === 'hitandrun') {
        // Show static image for Hit and Run
        videoEl.pause();
        videoEl.style.display = 'none';
        imageEl.style.display = 'block';
        imageEl.src = '/media/hitandrun_static.jpg';
        imageEl.alt = project.title;
      } else if (project.modalImage) {
        // Show static image instead of video
        videoEl.pause();
        videoEl.style.display = 'none';
        imageEl.style.display = 'block';
        imageEl.src = project.modalImage;
        imageEl.alt = project.title;
      } else if (project.video) {
        // Show video
        videoEl.pause();
        videoEl.currentTime = 0;
        videoEl.innerHTML = '';
        videoEl.style.display = 'block';
        imageEl.style.display = 'none';
        const source = document.createElement('source');
        source.src = project.video.src;
        source.type = 'video/mp4';
        videoEl.appendChild(source);
        videoEl.poster = project.video.poster;
        videoEl.load();
        videoEl.play();
      }

      // Handle credits
      const credits = parseCredits(project.description);
      if (credits.length > 0) {
        creditsEl.style.display = 'block';
        creditsList.innerHTML = '';
        credits.forEach(credit => {
          const item = document.createElement('div');
          item.className = 'credit-item';
          item.innerHTML = `
            <span class="credit-role">${credit.role}</span>
            <span class="credit-name">${credit.name}</span>
          `;
          creditsList.appendChild(item);
        });
      } else {
        creditsEl.style.display = 'none';
      }

      // Handle press (if available in project data)
      if (project.press && project.press.length > 0) {
        pressEl.style.display = 'block';
        pressList.innerHTML = '';
        project.press.forEach(item => {
          const link = document.createElement('a');
          link.className = 'press-link';
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.innerHTML = `${item.title}<span class="underline"></span>`;
          pressList.appendChild(link);
        });
      } else {
        pressEl.style.display = 'none';
      }

      // Handle awards (if available in project data)
      const awardsEl = document.getElementById('modal-awards');
      const awardsList = document.getElementById('awards-list');
      if (project.awards && project.awards.length > 0) {
        awardsEl.style.display = 'block';
        awardsList.innerHTML = '';
        project.awards.forEach(item => {
          const link = document.createElement('a');
          link.className = 'press-link';
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.innerHTML = `${item.title}<span class="underline"></span>`;
          awardsList.appendChild(link);
        });
      } else {
        awardsEl.style.display = 'none';
      }

      // Handle gallery
      if (project.gallery && project.gallery.images && project.gallery.images.length > 0) {
        galleryEl.style.display = 'block';
        currentGalleryImages = project.gallery.images.map(img => ({ src: img.full, alt: img.alt }));
        galleryGrid.innerHTML = currentGalleryImages.map((img, idx) =>
          `<img src="${img.src}" alt="${img.alt}" loading="lazy" data-index="${idx}" />`
        ).join('');
        // Click to open lightbox
        galleryGrid.querySelectorAll('img').forEach(imgEl => {
          imgEl.addEventListener('click', () => {
            const idx = parseInt(imgEl.getAttribute('data-index'), 10) || 0;
            openLightbox(idx);
          });
        });
      } else {
        galleryEl.style.display = 'none';
      }

      // Always start modal scroll position at the top
      if (modalContent) {
        modalContent.scrollTop = 0;
      }

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Update URL hash for deep linking
      if (history.pushState) {
        history.pushState({ projectId: projectId }, '', '#' + projectId);
      } else {
        window.location.hash = projectId;
      }

      // Ensure scroll is at top after activation/animation as well
      if (modalContent) {
        requestAnimationFrame(() => {
          modalContent.scrollTop = 0;
        });
      }
    };

    // Theme handling
    const savedTheme = (typeof localStorage !== 'undefined') ? localStorage.getItem('projectModalTheme') : null;
    if (savedTheme === 'dark') {
      modalContent.classList.add('modal-dark');
      if (themeToggle) {
        themeToggle.classList.add('is-dark');
        themeToggle.setAttribute('aria-pressed', 'true');
      }
    } else {
      modalContent.classList.remove('modal-dark');
      if (themeToggle) {
        themeToggle.classList.remove('is-dark');
        themeToggle.setAttribute('aria-pressed', 'false');
      }
    }

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const isDark = modalContent.classList.toggle('modal-dark');
        if (typeof localStorage !== 'undefined') {
          localStorage.setItem('projectModalTheme', isDark ? 'dark' : 'light');
        }
        themeToggle.classList.toggle('is-dark', isDark);
        themeToggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
      });
    }

    function openLightbox(index) {
      if (!currentGalleryImages || currentGalleryImages.length === 0) return;
      galleryLightboxIndex = Math.max(0, Math.min(index, currentGalleryImages.length - 1));
      const img = currentGalleryImages[galleryLightboxIndex];
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt || 'Preview';
      lightbox.classList.add('active');
      lightbox.style.display = 'flex';
      lightbox.setAttribute('aria-hidden', 'false');
      lightboxOpen = true;
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.style.display = 'none';
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxOpen = false;
      document.body.style.overflow = 'hidden';
    }

    function stepLightbox(delta) {
      if (!lightboxOpen) return;
      const nextIndex = (galleryLightboxIndex + delta + currentGalleryImages.length) % currentGalleryImages.length;
      openLightbox(nextIndex);
    }

    // Close modal
    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      videoEl.pause();
      videoEl.currentTime = 0;
      videoEl.innerHTML = '';
      videoEl.style.display = 'none';
      imageEl.style.display = 'none';
      imageEl.src = '';
      if (modalContent) modalContent.scrollTop = 0;

      // Clear URL hash
      if (history.pushState) {
        history.pushState(null, '', window.location.pathname);
      } else {
        window.location.hash = '';
      }
    }

    // Event listeners
    modalClose.addEventListener('click', () => {
      if (lightboxOpen) closeLightbox();
      closeModal();
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Lightbox controls
    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    lightboxPrev.addEventListener('click', () => stepLightbox(-1));
    lightboxNext.addEventListener('click', () => stepLightbox(1));

    // Keyboard controls
    document.addEventListener('keydown', (e) => {
      if (lightboxOpen) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') stepLightbox(-1);
        if (e.key === 'ArrowRight') stepLightbox(1);
        return;
      }
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeModal();
      // Arrow keys to navigate between projects
      if (e.key === 'ArrowLeft') navigateProject(-1);
      if (e.key === 'ArrowRight') navigateProject(1);
    });

    // Navigate to next/previous project
    function navigateProject(delta) {
      if (projectIds.length === 0) return;
      const newIndex = (currentProjectIndex + delta + projectIds.length) % projectIds.length;
      const newProjectId = projectIds[newIndex];
      if (newProjectId) {
        window.openProjectModal(newProjectId, false);
      }
    }

    // Swipe gestures for mobile
    if (isTouch) {
      const hasSeenSwipeIndicator = localStorage.getItem('hasSeenSwipeIndicator');

      modalContent.addEventListener('touchstart', (e) => {
        if (lightboxOpen) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchCurrentX = touchStartX;
        isDragging = true;
        isHorizontalSwipe = null;
      }, { passive: true });

      modalContent.addEventListener('touchmove', (e) => {
        if (!isDragging || lightboxOpen) return;
        touchCurrentX = e.touches[0].clientX;
        const touchCurrentY = e.touches[0].clientY;
        const deltaX = touchCurrentX - touchStartX;
        const deltaY = touchCurrentY - touchStartY;

        // Determine if horizontal or vertical swipe on first significant movement
        if (isHorizontalSwipe === null && (Math.abs(deltaX) > 10 || Math.abs(deltaY) > 10)) {
          isHorizontalSwipe = Math.abs(deltaX) > Math.abs(deltaY);
        }

        // Only handle horizontal swipes for navigation
        if (isHorizontalSwipe && deltaX > 0) {
          // Swiping right - show visual feedback
          modalContent.classList.add('dragging');
          modalContent.style.transform = `translateX(${Math.min(deltaX * 0.3, 100)}px)`;
        }
      }, { passive: true });

      modalContent.addEventListener('touchend', () => {
        if (!isDragging || lightboxOpen) return;
        const deltaX = touchCurrentX - touchStartX;
        modalContent.classList.remove('dragging');
        modalContent.style.transform = '';

        // Swipe threshold
        const threshold = 80;

        if (isHorizontalSwipe) {
          if (deltaX > threshold) {
            // Swipe right - close modal or go to previous
            closeModal();
          } else if (deltaX < -threshold) {
            // Swipe left - go to next project
            navigateProject(1);
          }
        }

        isDragging = false;
        isHorizontalSwipe = null;
      });

      // Show swipe indicator for first-time users
      if (!hasSeenSwipeIndicator && swipeIndicator) {
        // Show after modal opens
        const showSwipeIndicator = () => {
          if (modal.classList.contains('active')) {
            setTimeout(() => {
              swipeIndicator.classList.add('visible');
              setTimeout(() => {
                swipeIndicator.classList.remove('visible');
                localStorage.setItem('hasSeenSwipeIndicator', 'true');
              }, 3000);
            }, 1000);
          }
        };

        // Observe modal opening
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === 'class' && modal.classList.contains('active')) {
              showSwipeIndicator();
              observer.disconnect();
            }
          });
        });
        observer.observe(modal, { attributes: true });
      }
    }

    // Deep linking: open project from URL hash on page load
    function checkHashAndOpenProject() {
      const hash = window.location.hash.slice(1); // Remove the '#'
      if (hash) {
        window.openProjectModal(hash);
      }
    }

    // Check hash on initial load
    checkHashAndOpenProject();

    // Handle browser back/forward navigation
    window.addEventListener('popstate', (e) => {
      const hash = window.location.hash.slice(1);
      if (hash) {
        window.openProjectModal(hash, false);
      } else {
        // No hash means we should close the modal
        if (modal.classList.contains('active')) {
          modal.classList.remove('active');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          videoEl.pause();
          videoEl.currentTime = 0;
          videoEl.innerHTML = '';
          videoEl.style.display = 'none';
          imageEl.style.display = 'none';
          imageEl.src = '';
          if (modalContent) modalContent.scrollTop = 0;
        }
      }
    });
  }

  // Initialize modal immediately - the script runs after the HTML is parsed
  initModal();
</script>

