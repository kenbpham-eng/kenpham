---
// ProjectModal.astro - Lightweight modal component for project galleries
// No SSR data loading - uses JSON and vanilla JS for interactivity
---

<div id="project-modal" class="modal-overlay" role="dialog" aria-hidden="true">
  <!-- Loading Spinner -->
  <div class="modal-loading" id="modal-loading">
    <div class="spinner"></div>
  </div>

  <!-- Swipe indicator for mobile -->
  <div class="swipe-indicator" id="swipe-indicator">
    <span class="swipe-arrow left">‹</span>
    <span class="swipe-text">Swipe to navigate</span>
    <span class="swipe-arrow right">›</span>
  </div>

  <div class="modal-content">
    <div class="pull-indicator"></div>
    <button class="modal-close" aria-label="Close modal">
      <span>×</span>
    </button>
    
    <div class="modal-body">
      <div class="modal-header">
        <div class="title-row">
          <h2 id="modal-title"></h2>
        </div>
        <div class="modal-metadata" id="modal-metadata"></div>
      </div>

      <div id="modal-vimeo-embeds" class="modal-vimeo-embeds" style="display: none;">
        <div class="vimeo-embeds-grid" id="vimeo-embeds-grid"></div>
      </div>

      <div id="modal-links" class="modal-links" style="display: none;">
        <div class="links-list" id="links-list"></div>
      </div>

      <div class="modal-description" id="modal-description"></div>

      <div id="modal-director-note" class="modal-director-note" style="display: none;">
        <h3>DIRECTOR'S NOTE</h3>
        <p id="director-note-text"></p>
      </div>

      <div id="modal-featuring" class="modal-featuring" style="display: none;">
        <div class="featuring-label" id="featuring-label"></div>
        <div class="featuring-names" id="featuring-names"></div>
        <div class="featuring-laurel" id="featuring-laurel"></div>
      </div>

      <div id="modal-credits" class="modal-credits" style="display: none;">
        <h3>CREDITS</h3>
        <div class="credits-list" id="credits-list"></div>
      </div>

      <div id="modal-awards" class="modal-awards" style="display: none;">
        <h3>AWARDS</h3>
        <div class="awards-list" id="awards-list"></div>
      </div>

      <div id="modal-press" class="modal-press" style="display: none;">
        <h3>PRESS</h3>
        <div class="press-list" id="press-list"></div>
      </div>

      <div id="modal-gallery" class="modal-gallery" style="display: none;">
        <h3>STILLS</h3>
        <div class="gallery-grid" id="gallery-grid"></div>
      </div>
    </div>
  </div>
</div>

<!-- Video theater overlay for Vimeo embeds -->
<div id="video-theater" class="video-theater" aria-hidden="true" style="display:none;">
  <button id="video-theater-close" class="video-theater-close" aria-label="Close video">×</button>
  <div class="video-theater-inner">
    <div class="video-theater-wrapper">
      <iframe id="video-theater-iframe" src="" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    </div>
  </div>
</div>

<!-- Lightbox overlay for enlarged stills -->
<div id="lightbox-overlay" class="lightbox-overlay" aria-hidden="true" style="display:none;">
  <button id="lightbox-close" class="lightbox-close" aria-label="Close image">×</button>
  <img id="lightbox-image" alt="Preview" />
  <button id="lightbox-prev" class="lightbox-prev" aria-label="Previous">‹</button>
  <button id="lightbox-next" class="lightbox-next" aria-label="Next">›</button>
</div>

<style is:global>
  .modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
    align-items: center;
    justify-content: center;
  }

  .modal-overlay.active {
    display: flex;
    opacity: 1;
  }

  /* Loading Spinner */
  .modal-loading {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1010;
  }

  .modal-loading.visible {
    display: flex;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.2);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* Swipe Indicator */
  .swipe-indicator {
    display: none;
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    padding: 10px 20px;
    border-radius: 20px;
    font-size: 13px;
    z-index: 1050;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .swipe-indicator.visible {
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 1;
  }

  .swipe-arrow {
    font-size: 18px;
    animation: swipePulse 1.5s ease-in-out infinite;
  }

  .swipe-arrow.left {
    animation-delay: 0s;
  }

  .swipe-arrow.right {
    animation-delay: 0.75s;
  }

  @keyframes swipePulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  /* Pull-to-close indicator */
  .pull-indicator {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    width: 40px;
    height: 4px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 2px;
    z-index: 1002;
    display: none;
  }

  @media (max-width: 768px) {
    .pull-indicator {
      display: block;
    }
  }

  /* Modal dragging state */
  .modal-content.dragging {
    transition: none !important;
  }

  .modal-content.closing {
    animation: modalOut 0.25s ease forwards;
  }

  @keyframes modalOut {
    from { transform: scale(1) translateY(0); opacity: 1; }
    to   { transform: scale(0.93) translateY(16px); opacity: 0; }
  }

  .modal-content {
    position: relative;
    width: min(1200px, 92vw);
    max-height: 88vh;
    height: auto;
    background: #F2F0EC;
    padding: 0 28px 32px;
    border-radius: 20px;
    animation: modalIn 0.35s cubic-bezier(0.34, 1.4, 0.64, 1);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
  }

  @keyframes modalIn {
    from { transform: scale(0.93) translateY(16px); opacity: 0; }
    to   { transform: scale(1) translateY(0);       opacity: 1; }
  }

  .modal-overlay.active .modal-content {
    animation: modalIn 0.35s cubic-bezier(0.34, 1.4, 0.64, 1) forwards;
  }

  .modal-close {
    position: sticky;
    top: 20px;
    float: right;
    background: none;
    border: none;
    color: #000000;
    font-size: 32px;
    cursor: pointer;
    z-index: 1001;
    transition: opacity 0.2s;
    padding: 8px;
    margin: -8px -8px 20px 0;
  }

  .modal-close:hover {
    opacity: 0.6;
  }

  /* Header layout */
  .modal-header { margin-bottom: 16px; margin-top: 0; padding-top: 16px; }
  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Light site = dark modal */
  body.light-mode .modal-content { background: #1C1C1E; }
  body.light-mode .modal-content .modal-close { color: #fff; }
  body.light-mode .modal-content #modal-title { color: #fff; }
  body.light-mode .modal-content .modal-metadata { color: rgba(255,255,255,0.7); }
  body.light-mode .modal-content .modal-year { color: rgba(255,255,255,0.6); }
  body.light-mode .modal-content .featuring-label { color: rgba(255,255,255,0.6); }
  body.light-mode .modal-content .featuring-names { color: #fff; }
  body.light-mode .modal-content .modal-description { color: #fff; }
  body.light-mode .modal-content .modal-description .description-label { color: rgba(255,255,255,0.6) !important; }
  body.light-mode .modal-content .modal-description .description-value { color: #fff !important; }
  body.light-mode .modal-content .modal-credits h3,
  body.light-mode .modal-content .modal-links h3,
  body.light-mode .modal-content .modal-press h3,
  body.light-mode .modal-content .modal-awards h3,
  body.light-mode .modal-content .modal-gallery h3,
  body.light-mode .modal-content .modal-director-note h3 { color: #fff; }
  body.light-mode .modal-content .credits-list { color: #fff !important; }
  body.light-mode .modal-content .credit-item { color: #fff !important; }
  body.light-mode .modal-content .credit-role { color: rgba(255,255,255,0.6) !important; }
  body.light-mode .modal-content .credit-name { color: #fff !important; }
  body.light-mode .modal-content .press-link { color: #fff; }
  body.light-mode .modal-content .press-link .underline { background: #fff; }
  body.light-mode .modal-content .featuring-laurel img { filter: none; }
  body.light-mode .modal-content .pull-indicator { background: rgba(255,255,255,0.3); }

  /* moved header spacing above */

  #modal-title {
    margin: 0;
    font-size: 32px;
    font-weight: 700;
    color: #000000;
    letter-spacing: -0.5px;
    word-break: break-word;
  }

  .modal-metadata {
    color: rgba(0, 0, 0, 0.7);
    font-size: 13px;
    letter-spacing: 0.3px;
    margin-top: 8px;
  }

  .modal-year {
    color: rgba(0, 0, 0, 0.6);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    white-space: nowrap;
    display: none;
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .modal-featuring {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 0px;
    margin-bottom: 24px;
  }

  .featuring-label {
    color: rgba(0, 0, 0, 0.6);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .featuring-names {
    color: #000000;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
  }

  .featuring-laurel {
    margin-top: 12px;
  }

  .featuring-laurel img {
    max-width: 30px;
    height: auto;
    display: block;
    filter: brightness(0) saturate(100%);
  }

  .featuring-laurel-img {
    max-width: 30px !important;
    height: auto !important;
    display: block !important;
    width: auto !important;
  }

  .modal-description {
    color: #000000;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 24px;
    max-width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 32px;
  }
  
  .modal-description p {
    grid-column: 1 / -1;
    margin: 0;
    line-height: 1.6;
  }

  .modal-description .description-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .modal-description .description-label {
    color: rgba(0, 0, 0, 0.6) !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
  }

  .modal-description .description-value {
    color: #000000 !important;
    font-weight: 700;
    font-size: 14px;
  }

  .modal-director-note {
    margin-bottom: 32px;
  }

  .modal-director-note p {
    font-size: 15.4px;
    font-style: italic;
    line-height: 1.75;
    color: #000000;
    margin: 0;
  }

  body.light-mode .modal-content .modal-director-note p {
    color: #ffffff !important;
  }

  body.light-mode .modal-content .modal-director-note h3 {
    color: #ffffff !important;
  }

  .modal-credits h3,
  .modal-links h3,
  .modal-press h3,
  .modal-awards h3,
  .modal-director-note h3,
  .modal-gallery h3 {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 24px 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .modal-credits {
    margin-bottom: 32px;
  }

  .modal-links {
    margin-bottom: 12px;
  }

  .links-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .links-list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border: 1px solid #000;
    color: #000;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .links-list a:hover {
    background: #000;
    color: #fff;
  }

  body.light-mode .modal-content .links-list a {
    border-color: #fff;
    color: #fff;
  }

  body.light-mode .modal-content .links-list a:hover {
    background: #fff;
    color: #000;
  }

  .modal-press {
    margin-bottom: 32px;
  }

  .modal-awards {
    margin-bottom: 32px;
  }

  .modal-gallery {
    margin-bottom: 32px;
  }

  .modal-vimeo-embeds {
    margin-bottom: 32px;
  }

  .vimeo-embeds-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .vimeo-embed-item {
    flex: 1 1 0;
    min-width: 140px;
  }

  .vimeo-embed-wrapper {
    position: relative;
    padding-bottom: 177.78%; /* 9:16 */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #111;
  }

  .vimeo-embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vimeo-switcher-buttons {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .vimeo-switcher-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 18px;
    border: 1px solid #000;
    background: transparent;
    color: #000;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .vimeo-switcher-btn:hover,
  .vimeo-switcher-btn.active {
    background: #000;
    color: #fff;
  }

  body.light-mode .modal-content .vimeo-switcher-btn {
    border-color: #fff;
    color: #fff;
  }

  body.light-mode .modal-content .vimeo-switcher-btn:hover,
  body.light-mode .modal-content .vimeo-switcher-btn.active {
    background: #fff;
    color: #000;
  }

  .modal-gallery h3 {
    margin: 0 0 16px 0;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #000000;
  }

  .credits-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 32px;
    font-size: 13px;
    line-height: 1.5;
    color: #000000 !important;
  }

  .credit-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: #000000 !important;
  }

  .credit-role {
    color: rgba(0, 0, 0, 0.6) !important;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 500;
    display: block;
  }

  .credit-name {
    color: #000000 !important;
    font-weight: 700;
    font-size: 14px;
    display: block;
  }

  .press-list {
    font-size: 14px;
    line-height: 1.6;
  }

  .awards-list {
    font-size: 14px;
    line-height: 1.6;
  }
  .awards-list a {
    display: block;
    margin-bottom: 8px;
    white-space: normal;
  }

  .press-link {
    color: #000000;
    text-decoration: none;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.3px;
    transition: opacity 0.2s ease;
    position: relative;
    display: block;
    margin-bottom: 12px;
  }

  .press-link:hover {
    opacity: 0.7;
  }

  .press-link .underline {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: #000;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(.4,0,.2,1);
    pointer-events: none;
  }

  .press-link:hover .underline {
    transform: scaleX(1);
  }

  .gallery-grid {
    display: block;
    margin-top: 16px;
  }

  .gallery-grid img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    cursor: zoom-in;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      columns: 2;
      column-gap: 24px;
      column-fill: balance;
    }
    
    .gallery-grid img {
      break-inside: avoid;
      margin-bottom: 24px;
      display: inline-block;
      vertical-align: top;
    }
  }

  /* Lightbox */
  .video-theater {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
  }
  .video-theater.active { display: flex; }
  .video-theater-close {
    position: absolute;
    top: 24px;
    right: 32px;
    background: none;
    border: none;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    cursor: pointer;
    z-index: 10;
    padding: 4px 8px;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .video-theater-close:hover { opacity: 1; }
  .video-theater-inner {
    width: 90vw;
    max-width: 1100px;
  }
  .video-theater-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
  }
  .video-theater-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
  }

  .lightbox-overlay.active { display: flex; }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    padding: 8px;
    cursor: pointer;
    z-index: 2001;
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: #fff;
    font-size: 40px;
    cursor: pointer;
    padding: 16px 20px;
    transition: background 0.2s;
    z-index: 2001;
  }

  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }

  .lightbox-prev:hover,
  .lightbox-next:hover { background: rgba(255,255,255,0.35); }

  #lightbox-image {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.45);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .modal-content {
      width: 94vw;
      max-height: 92vh;
      padding: 0 20px 24px;
      border-radius: 16px;
    }

    .modal-close {
      top: 12px;
      right: 12px;
      font-size: 28px;
    }

    #modal-title {
      font-size: 20px;
    }

    /* Keep title and toggle on one line when space allows */
    .title-row { gap: 12px; }

    .modal-year {
      font-size: 12px;
    }

    .lightbox-prev,
    .lightbox-next {
      padding: 12px 16px;
      font-size: 28px;
    }
  }
</style>

<script define:vars={{ projectsUrl: '/data/projects.json' }}>
  let projectsData = null;
  let galleryLightboxIndex = 0;
  let currentGalleryImages = [];
  let modalInitialized = false;
  let lightboxOpen = false;
  let currentProjectIndex = 0;
  let projectIds = [];

  // Wait for DOM to be ready
  function initModal() {
    const modal = document.getElementById('project-modal');
    const modalContent = modal.querySelector('.modal-content');
    const modalLoading = document.getElementById('modal-loading');
    const swipeIndicator = document.getElementById('swipe-indicator');
    const isTouch = matchMedia("(hover: none) and (pointer: coarse)").matches;

    // Swipe gesture variables
    let touchStartX = 0;
    let touchStartY = 0;
    let touchCurrentX = 0;
    let isDragging = false;
    let isHorizontalSwipe = null;
    const modalClose = document.querySelector('.modal-close');
    const descriptionEl = document.getElementById('modal-description');
    const titleEl = document.getElementById('modal-title');
    const metadataEl = document.getElementById('modal-metadata');
    const featuringEl = document.getElementById('modal-featuring');
    const featuringLabelEl = document.getElementById('featuring-label');
    const featuringNamesEl = document.getElementById('featuring-names');
    const featuringLaurelEl = document.getElementById('featuring-laurel');
    const creditsEl = document.getElementById('modal-credits');
    const creditsList = document.getElementById('credits-list');
    const pressEl = document.getElementById('modal-press');
    const pressList = document.getElementById('press-list');
    const galleryEl = document.getElementById('modal-gallery');
    const galleryGrid = document.getElementById('gallery-grid');
    const lightbox = document.getElementById('lightbox-overlay');
    const lightboxImg = document.getElementById('lightbox-image');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    // Lazy load projects data
    async function loadProjects() {
      if (projectsData) return projectsData;
      try {
        const response = await fetch(projectsUrl);
        projectsData = await response.json();
        return projectsData;
      } catch (error) {
        console.error('Error loading projects:', error);
        return null;
      }
    }

    // Extract featuring line from description
    function extractFeaturing(description) {
      if (!description) return null;
      const lines = description.split('\n');
      const featuringLine = lines.find(line => line.trim().startsWith('Featuring:'));
      if (!featuringLine) return null;
      // Extract the names part after "Featuring:"
      const featuringText = featuringLine.trim();
      const names = featuringText.replace(/^Featuring:\s*/, '');
      return names;
    }

    // Parse credits from description (format: Role: Name\n)
    function parseCredits(description) {
      if (!description) return [];
      // Skip first 2 lines (synopsis and blank), then get lines with colons but not Featuring line
      const lines = description.split('\n').slice(2).filter(line => line.trim().includes(':') && !line.trim().startsWith('Featuring:'));
      return lines.map(line => {
        const [role, name] = line.split(':').map(s => s.trim());
        return { role, name };
      });
    }

    // Open modal with project data
    window.openProjectModal = async function(projectId, showLoading = true) {
      // Show loading spinner
      if (showLoading && modalLoading) {
        modalLoading.classList.add('visible');
      }

      const data = await loadProjects();
      if (!data) {
        if (modalLoading) modalLoading.classList.remove('visible');
        return;
      }

      // Build project IDs list for navigation
      projectIds = data.projects.map(p => p.id);
      currentProjectIndex = projectIds.indexOf(projectId);

      const project = data.projects.find(p => p.id === projectId);
      if (!project) {
        if (modalLoading) modalLoading.classList.remove('visible');
        return;
      }

      // Hide loading spinner
      if (modalLoading) {
        modalLoading.classList.remove('visible');
      }

      titleEl.textContent = project.title;
      if (project.metadata) {
        metadataEl.textContent = project.metadata;
      } else {
        metadataEl.textContent = '';
      }
      
      // Format description with label/value pairs
      const descLines = project.description.split('\n').slice(0, 2).filter(line => line.trim());
      descriptionEl.innerHTML = descLines.map(line => {
        if (line.includes(':')) {
          const [label, value] = line.split(':').map(s => s.trim());
          return `
            <div class="description-item">
              <span class="description-label">${label}</span>
              <span class="description-value">${value}</span>
            </div>
          `;
        }
        return `<p style="margin: 0; line-height: 1.6;">${line}</p>`;
      }).join('');

      // Handle featuring
      const featuringNames = extractFeaturing(project.description);
      // Check if project has laurel images
      let hasLaurel = false;
      if (projectId === 'thatwhichisheard') {
        featuringLaurelEl.innerHTML = '<img src="/portfolio/thatwhichisheard/DOCNYC25_Laurels_OfficialSelection_White.png" alt="DOC NYC 2025 Official Selection" loading="lazy" style="max-width: 150px; height: auto; display: block; width: auto;" />';
        hasLaurel = true;
      } else if (projectId === 'halfwaybroken') {
        featuringLaurelEl.innerHTML = '<img src="/portfolio/halfwaybroken/cropped-1.-TIMVF-logo-PNG.png" alt="Toronto International Motorcycle and Vehicle Festival" loading="lazy" style="max-width: 150px; height: auto; display: block; width: auto;" />';
        hasLaurel = true;
      } else if (projectId === 'thehallpass' && project.laurels && project.laurels.length > 0) {
        featuringLaurelEl.innerHTML = project.laurels.map(laurel => `<img src="${laurel.src}" alt="${laurel.alt}" loading="lazy" style="max-width: 150px; height: auto; display: inline-block; width: auto; margin-right: 12px;" />`).join('');
        hasLaurel = true;
      } else {
        featuringLaurelEl.innerHTML = '';
      }

      if (featuringNames) {
        featuringLabelEl.textContent = 'FEATURING';
        featuringNamesEl.textContent = featuringNames;
        featuringEl.style.display = 'flex';
      } else if (hasLaurel) {
        featuringLabelEl.textContent = '';
        featuringNamesEl.textContent = '';
        featuringEl.style.display = 'flex';
      } else {
        featuringEl.style.display = 'none';
      }

      // Handle credits
      const credits = parseCredits(project.description);
      if (credits.length > 0) {
        creditsEl.style.display = 'block';
        creditsList.innerHTML = '';
        credits.forEach(credit => {
          const item = document.createElement('div');
          item.className = 'credit-item';
          item.innerHTML = `
            <span class="credit-role">${credit.role}</span>
            <span class="credit-name">${credit.name}</span>
          `;
          creditsList.appendChild(item);
        });
      } else {
        creditsEl.style.display = 'none';
      }

      // Handle watch links (if available in project data)
      const linksEl = document.getElementById('modal-links');
      const linksList = document.getElementById('links-list');
      if (project.links && project.links.length > 0) {
        linksEl.style.display = 'block';
        linksList.innerHTML = '';
        project.links.forEach(item => {
          const link = document.createElement('a');
          link.href = '#';
          link.innerHTML = `▶ ${item.title}`;
          link.addEventListener('click', (e) => {
            e.preventDefault();
            openVideoTheater(item.url);
          });
          linksList.appendChild(link);
        });
      } else {
        linksEl.style.display = 'none';
      }

      // Handle director's note (if available in project data)
      const directorNoteEl = document.getElementById('modal-director-note');
      const directorNoteTextEl = document.getElementById('director-note-text');
      if (project.directorNote) {
        directorNoteTextEl.textContent = project.directorNote;
        directorNoteEl.style.display = 'block';
      } else {
        directorNoteEl.style.display = 'none';
      }

      // Handle press (if available in project data)
      if (project.press && project.press.length > 0) {
        pressEl.style.display = 'block';
        pressList.innerHTML = '';
        project.press.forEach(item => {
          const link = document.createElement('a');
          link.className = 'press-link';
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.innerHTML = `${item.title}<span class="underline"></span>`;
          pressList.appendChild(link);
        });
      } else {
        pressEl.style.display = 'none';
      }

      // Handle awards (if available in project data)
      const awardsEl = document.getElementById('modal-awards');
      const awardsList = document.getElementById('awards-list');
      if (project.awards && project.awards.length > 0) {
        awardsEl.style.display = 'block';
        awardsList.innerHTML = '';
        project.awards.forEach(item => {
          const link = document.createElement('a');
          link.className = 'press-link';
          link.href = item.url;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.innerHTML = `${item.title}<span class="underline"></span>`;
          awardsList.appendChild(link);
        });
      } else {
        awardsEl.style.display = 'none';
      }

      // Handle vimeo embeds
      const vimeoEmbedsEl = document.getElementById('modal-vimeo-embeds');
      const vimeoEmbedsGrid = document.getElementById('vimeo-embeds-grid');
      if (project.vimeoEmbeds && project.vimeoEmbeds.length > 0) {
        vimeoEmbedsEl.style.display = 'block';
        const is16x9 = project.vimeoEmbeds.some(e => e.aspectRatio === '16/9' || e.aspectRatio === '4/3');
        if (is16x9) {
          // Switcher UI: one video at a time with buttons
          const firstEmbed = project.vimeoEmbeds[0];
          vimeoEmbedsGrid.style.flexDirection = 'column';
          vimeoEmbedsGrid.innerHTML = `
            <div class="vimeo-switcher-buttons" id="vimeo-switcher-buttons">
              ${project.vimeoEmbeds.map((e, i) => `
                <button class="vimeo-switcher-btn${i === 0 ? ' active' : ''}" data-index="${i}">▶ ${e.title}</button>
              `).join('')}
            </div>
            <div class="vimeo-embed-item" style="flex:none;width:100%;">
              <div class="vimeo-embed-wrapper" style="padding-bottom:${project.vimeoEmbeds[0].aspectRatio === '4/3' ? '75%' : '56.25%'};">
                <iframe id="vimeo-switcher-iframe" src="${firstEmbed.src}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" title="${firstEmbed.title}" allowfullscreen></iframe>
              </div>
            </div>
          `;
          // Wire up buttons
          const embeds = project.vimeoEmbeds;
          vimeoEmbedsGrid.querySelectorAll('.vimeo-switcher-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const idx = parseInt(btn.getAttribute('data-index'), 10);
              vimeoEmbedsGrid.querySelectorAll('.vimeo-switcher-btn').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              const iframe = document.getElementById('vimeo-switcher-iframe');
              iframe.src = embeds[idx].src;
              iframe.title = embeds[idx].title;
            });
          });
        } else {
          vimeoEmbedsGrid.style.flexDirection = is16x9 ? 'column' : 'row';
          vimeoEmbedsGrid.innerHTML = project.vimeoEmbeds.map(embed => {
            const padding = embed.aspectRatio === '16/9' ? '56.25%' : embed.aspectRatio === '4/3' ? '75%' : '177.78%';
            return `
              <div class="vimeo-embed-item" style="${is16x9 ? 'flex:none;width:100%;' : ''}">
                <div class="vimeo-embed-wrapper" style="padding-bottom:${padding};">
                  <iframe src="${embed.src}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" title="${embed.title}" allowfullscreen></iframe>
                </div>
              </div>
            `;
          }).join('');
        }
      } else {
        vimeoEmbedsEl.style.display = 'none';
      }

      // Handle gallery
      if (project.gallery && project.gallery.images && project.gallery.images.length > 0) {
        galleryEl.style.display = 'block';
        currentGalleryImages = project.gallery.images.map(img => ({ src: img.full, alt: img.alt }));
        galleryGrid.innerHTML = currentGalleryImages.map((img, idx) =>
          `<img src="${img.src}" alt="${img.alt}" loading="lazy" data-index="${idx}" />`
        ).join('');
        // Click to open lightbox
        galleryGrid.querySelectorAll('img').forEach(imgEl => {
          imgEl.addEventListener('click', () => {
            const idx = parseInt(imgEl.getAttribute('data-index'), 10) || 0;
            openLightbox(idx);
          });
        });
      } else {
        galleryEl.style.display = 'none';
      }

      // Always start modal scroll position at the top
      if (modalContent) {
        modalContent.scrollTop = 0;
      }

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Ensure scroll is at top after activation/animation as well
      if (modalContent) {
        requestAnimationFrame(() => {
          modalContent.scrollTop = 0;
        });
      }
    };

    // Video theater
    const videoTheater = document.getElementById('video-theater');
    const videoTheaterIframe = document.getElementById('video-theater-iframe');
    const videoTheaterClose = document.getElementById('video-theater-close');

    function vimeoEmbedUrl(url) {
      // Convert https://vimeo.com/ID/HASH?... to https://player.vimeo.com/video/ID?h=HASH&autoplay=1
      const match = url.match(/vimeo\.com\/(\d+)\/([a-f0-9]+)/);
      if (match) return `https://player.vimeo.com/video/${match[1]}?h=${match[2]}&autoplay=1&color=fff`;
      return url;
    }

    function openVideoTheater(url) {
      videoTheaterIframe.src = vimeoEmbedUrl(url);
      videoTheater.style.display = 'flex';
      videoTheater.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeVideoTheater() {
      videoTheater.style.display = 'none';
      videoTheater.setAttribute('aria-hidden', 'true');
      videoTheaterIframe.src = '';
      document.body.style.overflow = '';
    }

    if (videoTheaterClose) videoTheaterClose.addEventListener('click', closeVideoTheater);
    if (videoTheater) videoTheater.addEventListener('click', (e) => {
      if (e.target === videoTheater || e.target === videoTheater.querySelector('.video-theater-inner')) closeVideoTheater();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && videoTheater.style.display === 'flex') closeVideoTheater();
    });

    function openLightbox(index) {
      if (!currentGalleryImages || currentGalleryImages.length === 0) return;
      galleryLightboxIndex = Math.max(0, Math.min(index, currentGalleryImages.length - 1));
      const img = currentGalleryImages[galleryLightboxIndex];
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt || 'Preview';
      lightbox.classList.add('active');
      lightbox.style.display = 'flex';
      lightbox.setAttribute('aria-hidden', 'false');
      lightboxOpen = true;
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.style.display = 'none';
      lightbox.setAttribute('aria-hidden', 'true');
      lightboxOpen = false;
      document.body.style.overflow = 'hidden';
    }

    function stepLightbox(delta) {
      if (!lightboxOpen) return;
      const nextIndex = (galleryLightboxIndex + delta + currentGalleryImages.length) % currentGalleryImages.length;
      openLightbox(nextIndex);
    }

    // Close modal
    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (modalContent) modalContent.scrollTop = 0;
      // Stop vimeo embeds
      const vimeoEmbedsGrid = document.getElementById('vimeo-embeds-grid');
      if (vimeoEmbedsGrid) vimeoEmbedsGrid.querySelectorAll('iframe').forEach(f => { f.src = f.src; });
    }

    // Event listeners
    modalClose.addEventListener('click', () => {
      if (lightboxOpen) closeLightbox();
      closeModal();
    });
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Lightbox controls
    lightboxClose.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    lightboxPrev.addEventListener('click', () => stepLightbox(-1));
    lightboxNext.addEventListener('click', () => stepLightbox(1));

    // Keyboard controls
    document.addEventListener('keydown', (e) => {
      if (lightboxOpen) {
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') stepLightbox(-1);
        if (e.key === 'ArrowRight') stepLightbox(1);
        return;
      }
      if (!modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeModal();
      // Arrow keys to navigate between projects
      if (e.key === 'ArrowLeft') navigateProject(-1);
      if (e.key === 'ArrowRight') navigateProject(1);
    });

    // Navigate to next/previous project
    function navigateProject(delta) {
      if (projectIds.length === 0) return;
      const newIndex = (currentProjectIndex + delta + projectIds.length) % projectIds.length;
      const newProjectId = projectIds[newIndex];
      if (newProjectId) {
        window.openProjectModal(newProjectId, false);
      }
    }

    // Swipe gestures for mobile
    if (isTouch) {
      const hasSeenSwipeIndicator = localStorage.getItem('hasSeenSwipeIndicator');

      modalContent.addEventListener('touchstart', (e) => {
        if (lightboxOpen) return;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchCurrentX = touchStartX;
        isDragging = true;
        isHorizontalSwipe = null;
      }, { passive: true });

      modalContent.addEventListener('touchmove', (e) => {
        if (!isDragging || lightboxOpen) return;
        touchCurrentX = e.touches[0].clientX;
        const touchCurrentY = e.touches[0].clientY;
        const deltaX = touchCurrentX - touchStartX;
        const deltaY = touchCurrentY - touchStartY;

        // Determine if horizontal or vertical swipe on first significant movement
        if (isHorizontalSwipe === null && (Math.abs(deltaX) > 10 || Math.abs(deltaY) > 10)) {
          isHorizontalSwipe = Math.abs(deltaX) > Math.abs(deltaY);
        }

        // Only handle horizontal swipes for navigation
        if (isHorizontalSwipe && deltaX > 0) {
          // Swiping right - show visual feedback
          modalContent.classList.add('dragging');
          modalContent.style.transform = `translateX(${Math.min(deltaX * 0.3, 100)}px)`;
        }
      }, { passive: true });

      modalContent.addEventListener('touchend', () => {
        if (!isDragging || lightboxOpen) return;
        const deltaX = touchCurrentX - touchStartX;
        modalContent.classList.remove('dragging');
        modalContent.style.transform = '';

        // Swipe threshold
        const threshold = 80;

        if (isHorizontalSwipe) {
          if (deltaX > threshold) {
            // Swipe right - close modal or go to previous
            closeModal();
          } else if (deltaX < -threshold) {
            // Swipe left - go to next project
            navigateProject(1);
          }
        }

        isDragging = false;
        isHorizontalSwipe = null;
      });

      // Show swipe indicator for first-time users
      if (!hasSeenSwipeIndicator && swipeIndicator) {
        // Show after modal opens
        const showSwipeIndicator = () => {
          if (modal.classList.contains('active')) {
            setTimeout(() => {
              swipeIndicator.classList.add('visible');
              setTimeout(() => {
                swipeIndicator.classList.remove('visible');
                localStorage.setItem('hasSeenSwipeIndicator', 'true');
              }, 3000);
            }, 1000);
          }
        };

        // Observe modal opening
        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.attributeName === 'class' && modal.classList.contains('active')) {
              showSwipeIndicator();
              observer.disconnect();
            }
          });
        });
        observer.observe(modal, { attributes: true });
      }
    }
  }

  // Initialize modal immediately - the script runs after the HTML is parsed
  initModal();
</script>

