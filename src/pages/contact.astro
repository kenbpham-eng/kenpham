---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Ken Pham | Contact";
---
<!doctype html>
<html lang="en">
  <head>
      <link rel="stylesheet" href="/styles/main.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content="Contact Ken Pham for narrative, documentary, and commercial directing." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://www.kenpham.ca/contact" />
    <!-- Plausible Analytics -->
    <script defer data-domain="www.kenpham.ca" src="https://plausible.io/js/script.js"></script>
    
    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content="Ken Pham" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ken Pham | Contact" />
    <meta property="og:description" content="Contact Ken Pham for narrative, documentary, and commercial directing." />
    <meta property="og:url" content="https://www.kenpham.ca/contact" />
    <meta property="og:image" content="https://www.kenpham.ca/images/about-kenpham.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ken Pham | Contact" />
    <meta name="twitter:description" content="Contact Ken Pham for narrative, documentary, and commercial directing." />
    <meta name="twitter:image" content="https://www.kenpham.ca/images/about-kenpham.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      /* ...existing code... */
      .wrap { max-width:100%; margin:0 auto; padding:32px; }
      
      @media (max-width: 768px) {
        .wrap { padding: 24px; }
      }

      .contact-content {
        margin-top: 48px;
      }

      .contact-grid {
        max-width: 640px;
      }

      .contact-info h3 {
        font-size: 14px;
        font-weight: 700;
        margin: 0 0 20px 0;
        letter-spacing: 1.5px;
        text-transform: uppercase;
      }

      .contact-info .contact-section + .contact-card + .contact-section h3 {
        margin-top: 48px;
      }

      .contact-card {
        display: flex;
        flex-direction: column;
        gap: 0;
      }

      .contact-card h4 {
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-color);
        margin: 0;
      }

      .contact-card h4:not(:first-child) {
        margin-top: 10px;
      }

      .contact-card p {
        margin: 0;
        font-size: 15px;
        line-height: 1.5;
        color: var(--text-color);
      }

      .contact-card a {
        color: var(--text-color);
        text-decoration: none;
        transition: opacity 0.2s ease;
      }

      .contact-card a:hover {
        opacity: 0.7;
        text-decoration: underline;
      }

      .contact-card a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
        border-radius: 0;
        text-decoration: underline;
      }

      .skip-link {
        position: absolute;
        left: -999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: fixed;
        left: 16px;
        top: 16px;
        width: auto;
        height: auto;
        padding: 10px 14px;
        background: #fff;
        color: #000;
        border-radius: 0;
        z-index: 100;
        text-decoration: none;
        border: 1px solid #0002;
        box-shadow: 0 2px 8px #0006;
      }
      
      /* View Transitions API */
      @view-transition {
        navigation: auto;
      }
      
      ::view-transition-old(root) {
        animation: fadeOut 0.3s ease;
      }
      
      ::view-transition-new(root) {
        animation: fadeIn 0.3s ease;
        background: var(--bg-color, #000000);
      }
      
      @keyframes fadeOut {
        to { opacity: 0; }
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="wrap">
      <SiteHeader />

      <main id="main-content" class="contact-content">
        <div class="contact-grid">
          <aside class="contact-info" aria-labelledby="direct-contact-heading">
            <div class="contact-section">
              <h3 id="direct-contact-heading">DIRECT CONTACT</h3>
            </div>
            <div class="contact-card">
              <h4>NARRATIVE, DOCUMENTARY &amp; OTHER</h4>
              <p><a href="mailto:kenbpham@icloud.com">kenbpham@icloud.com</a></p>

              <h4>COMMERCIAL DIRECTING &amp; PRODUCTION</h4>
              <p><a href="mailto:kpham@steakandsizzle.com">kpham@steakandsizzle.com</a></p>
            </div>

            <div class="contact-section">
              <h3 id="representation-heading">ON-CAMERA REPRESENTATION</h3>
            </div>
            <div class="contact-card">
              <h4>DANCE & CHOREOGRAPHY AGENT - TALENT</h4>
              <p>da Costa Talent Agency</p>
              <p>Peter da Costa</p>
              <p><a href="mailto:peter@dacostatalent.com">peter@dacostatalent.com</a></p>

              <h4>TV & FILM AGENT - TALENT</h4>
              <p>da Costa Talent Agency</p>
              <p>Frank da Costa</p>
              <p><a href="mailto:frank@dacostatalent.com">frank@dacostatalent.com</a></p>
            </div>
          </aside>

        </div>
      </main>
      
      <SiteFooter />
    </div>

    <button id="backToTop" aria-label="Back to top" tabindex="0" style="display:none;position:fixed;bottom:32px;right:32px;z-index:200;background:#000000cc;color:#fff;border:none;border-radius:0;width:48px;height:48px;box-shadow:0 2px 12px #0007;cursor:pointer;transition:opacity 0.2s;outline:none;font-size:24px;align-items:center;justify-content:center;">
      ↑
    </button>
    <style>
      #backToTop:focus { outline: 2px solid #fff; }
      #backToTop[hidden] { display: none !important; }
    </style>
    <script type="module">
      import { initBackToTop } from '/scripts/shared.js';
      initBackToTop();
    </script>
  </body>
</html>
