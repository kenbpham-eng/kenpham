<style>
    :root {
        --bg-dark: #000000;
        --bg-light: #ffffff;
        --bg-warm: #F5E6CC;
        --bg-cool: #eef2ff;
        --bg-accent: #4338ca;
        --text-light: #ffffff;
        --text-dark: #000000;
        --font-primary: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
        --font-heading: 'Work Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        font-family: var(--font-primary);
        -webkit-font-smoothing: antialiased;
    }

    :global(header) {
        background-color: #000000 !important;
    }

    :global(header h1),
    :global(header nav a) {
        color: #ffffff !important;
    }

    .page-wrap {
        width: 100%;
        min-height: 100vh;
    }

    .hero {
        min-height: 60vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 2rem;
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .hero h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 1rem;
        letter-spacing: 0.05em;
    }

    .hero p {
        font-size: 18px;
        max-width: 600px;
    }

    .section {
        padding: 4rem 2rem;
    }

    .section-content {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 2rem;
    }

    .section p,
    .section ul {
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 1rem;
    }

    .section ul {
        list-style: none;
        padding: 0;
    }

    .section li {
        padding: 0.5rem 0;
    }

    .section-dark {
        background: var(--bg-dark);
        color: var(--text-light);
    }

    .section-light {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .section-warm {
        background: var(--bg-warm);
        color: var(--text-dark);
    }

    .section-cool {
        background: var(--bg-cool);
        color: var(--text-dark);
    }

    .section-accent {
        background: var(--bg-accent);
        color: var(--text-light);
    }

    .work-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        margin-top: 2rem;
    }

    .work-item h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    @media (min-width: 768px) {
        .hero h1 {
            font-size: 48px;
        }

        .hero p {
            font-size: 20px;
        }

        .section {
            padding: 6rem 2rem;
        }

        .section h2 {
            font-size: 36px;
        }

        .section p,
        .section ul {
            font-size: 18px;
        }

        .work-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
