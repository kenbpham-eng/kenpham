---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Ken Pham | Work Samples";
---
<!doctype html>
<html lang="en">
  <head>
      <link rel="stylesheet" href="/styles/main.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content="Private work samples portfolio" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
                  .narrow-text {
                    max-width: 600px;
                    margin: 0 auto;
                    padding: 0 20px;
                    text-align: left;
                  }
            .intro-large {
              font-size: 14px;
              line-height: 1.7;
              font-family: var(--font-heading, 'Inter', 'Work Sans', Arial, sans-serif);
              font-weight: 400;
              margin-bottom: 18px;
            }
      body {
        background: #000000;
        color: rgba(242, 242, 242, 0.9);
      }



      .wrap { 
        max-width:100%; 
        margin:0 auto; 
        padding:32px;
      }
      
      @media (max-width: 768px) {
        .wrap { padding: 24px; }
      }


      .content {
        margin-top: 48px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 25px;
      }

      @media (max-width: 768px) {
        .content {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }

      .text-section {
        font-size: 16px;
        line-height: 1.8;
        color: rgba(242, 242, 242, 0.9);
      }

      .text-section p {
        margin-bottom: 24px;
      }

      .image-section {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        margin-bottom: 0;
      }

      .image-section img {
        width: 210px;
        height: 210px;
        object-fit: cover;
        object-position: 65% 25%;
        border-radius: 50%;
        display: block;
        background: none;
        margin-bottom: 40px;
      }

      @media (max-width: 768px) {
        .image-section {
          position: static;
          order: -1;
        }
      }

      .skip-link {
        position: absolute;
        left: -999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: fixed;
        left: 16px;
        top: 16px;
        width: auto;
        height: auto;
        padding: 10px 14px;
        background: #fff;
        color: #000;
        border-radius: 4px;
        z-index: 100;
        text-decoration: none;
        border: 1px solid #0002;
        box-shadow: 0 2px 8px #0006;
      }

      /* Work list item hover/focus underline */
      .work-item:hover,
      .work-item:focus {
        text-decoration: underline;
      }
      .work-item:focus {
        outline: none;
      }
      .work-item.active {
        text-decoration: underline;
      }
      
      /* View Transitions API */
      @view-transition {
        navigation: auto;
      }
      
      ::view-transition-old(root) {
        animation: fadeOut 0.3s ease;
      }
      
      ::view-transition-new(root) {
        animation: fadeIn 0.3s ease;
        background: #000000;
      }
      
      @keyframes fadeOut {
        to { opacity: 0; }
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="wrap">
      <SiteHeader />

      <main id="main-content" class="content">
        <div class="intro-clients-row" style="display:flex;gap:64px;justify-content:center;align-items:flex-start;width:100%;max-width:1400px;margin:0 auto 80px auto;">
          <div class="text-section" style="min-width: 400px; max-width: 600px;">
            <div class="image-section">
              <img src="/images/about-kenpham.webp" alt="Ken Pham" width="2033" height="2544" loading="lazy" />
            </div>
            <div class="narrow-text">
              <section>
                  <p style="font-size: 1.1rem; line-height: 1.7; font-family: var(--font-primary); color: var(--soft-shadow-grey);">
                    Hi there. I’m Ken Pham. I come from a long relationship with espresso, dance and choreography, and some how ended up directing and producing things for screens big and small.
                  </p>
              </section>
            </div>
          </div>
          <div class="client-list-section" style="min-width: 400px; max-width: 600px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; padding: 40px 32px;">
            <!-- Typewriter animation removed -->
            <h2 style="font-size: 2rem; margin-bottom: 18px; color: var(--soft-shadow-grey);">Select Clients</h2>
            <p style="font-size: 1.1rem; line-height: 1.7; color: var(--soft-shadow-grey);">
              Porsche, Volkswagen, Michelin Guide, PUMA, VinFast, Volvo, RBC, Arc'Teryx, Bootlegger, Gyptech, BMW, Volvo, Jaguar, Lexus, Landrover, Kia, Hankook, Banff Springs, A&amp;W, Wealthsimple
            </p>
            <br />
            <h2 style="font-size: 2rem; margin:18px 0 10px 0; color: var(--soft-shadow-grey);">Creative Services</h2>
            <br />
            <div style="font-size: 1.1rem; line-height: 1.7; color: var(--soft-shadow-grey); margin-bottom:0; max-width:600px;">
              Director-for-hire<br>
              Producer-for-hire<br>
              Branded Content<br>
              Commercial Spots<br>
              Narrative<br>
              Documentary<br>
              Production Services<br>
              Social Campaign Production<br>
              Consulting
            </div>
          </div>
        </div>
          <div class="work-list-preview-row" style="display:flex;gap:150px;justify-content:center;align-items:flex-start;width:100%;max-width:1400px;margin:0 auto 80px auto;">
            <div class="work-list" style="min-width:300px;max-width:340px;">
              <h2 style="font-size:2rem;font-family:var(--font-primary);font-weight:400;margin:18px 0 10px 0;color:var(--soft-shadow-grey);white-space:nowrap;">Select Works <span style="font-size:14px;">for Branded Content</span></h2>
              <ul id="workList" style="list-style:none;padding:0;margin:0;margin-top:0;">
                <li class="work-item" data-index="0" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">Porsche Canada, Driven By Dreamers with Christopher Sealy</li>
                <li class="work-item" data-index="1" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">Lucas Scarfone x Volvo</li>
                <li class="work-item" data-index="2" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">Porsche Canada, Driven by Dreamers with Elladj</li>
                <li class="work-item" data-index="3" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">A&amp;W, Rooty Turns 50 with Morgan Cameron Ross</li>
                <li class="work-item" data-index="4" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">Neil Anthony Watson x Volvo</li>
                <li class="work-item" data-index="5" style="padding:8px 0;cursor:pointer;font-size:14px;font-family:'Inter', 'Work Sans', Arial, sans-serif;font-weight:400;margin-top:2px;">Michelin Guide x Gail Simmons, My Toronto</li>
                <!-- Removed: Porsche Ice Experience 2024 -->
                <!-- Removed: Volkswagen Canada, Tiguan Highlight -->
              </ul>
              <div id="arrowNav" style="display:flex;justify-content:flex-start;gap:16px;margin-top:18px;">
                <button id="prevBtn" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--soft-shadow-grey);">&#8592;</button>
                <button id="nextBtn" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--soft-shadow-grey);">&#8594;</button>
                <button id="playPauseBtn" style="background:none;border:none;cursor:pointer;font-size:24px;color:var(--soft-shadow-grey);">&#9654;</button>
              </div>
            </div>
            <div class="work-preview" id="workPreview" style="flex:1;min-width:340px;max-width:700px;position:relative;">
              <!-- Default preview: first item (video only) -->
              <div class="hover-media" style="width:100%;">
                <video controls style="width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);" poster="">
                  <source src="/portfolio/socialfirstportfolio/grid/porschecanada_drivenbydreams_christophersealy.mp4" type="video/mp4" />
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>
          <script>
            const works = [
              {
                title: "Porsche Canada, Driven By Dreamers with Christopher Sealy",
                video: "/portfolio/socialfirstportfolio/grid/porschecanada_drivenbydreams_christophersealy.mp4",
                videoStyle: "width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);"
              },
              {
                title: "Lucas Scarfone x Volvo",
                video: "/portfolio/socialfirstportfolio/grid/volvoxlucas_1080.mp4",
                videoStyle: "width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);"
              },
              {
                title: "Porsche Canada, Driven by Dreamers with Elladj",
                video: "/portfolio/socialfirstportfolio/grid/dreamers_on_elladj_coloured_16x9_v1 (1440p).mp4",
                videoStyle: "width:100%;height:auto;max-width:600px;display:block;object-fit:cover;border-radius:24px;background:var(--gunmetal);"
              },
              {
                title: "A&W, Rooty Turns 50 with Morgan Cameron Ross",
                video: "/portfolio/socialfirstportfolio/grid/a&w__rooty_turns_50_|_morgan_cameron_ross_v1 (1080p).mp4",
                videoStyle: "width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);"
              },
              {
                title: "Neil Anthony Watson x Volvo",
                video: "/portfolio/socialfirstportfolio/grid/23146_-_neil_x_volvo_-_client_rc2_v1 (1080p).mp4",
                videoStyle: "width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);"
              },
              {
                title: "Michelin Guide x Gail Simmons, My Toronto",
                video: "/portfolio/socialfirstportfolio/grid/michelin_guide__my_toronto_series_|_gail_simmons_v1 (1080p).mp4",
                videoStyle: "width:100%;height:auto;max-width:400px;display:block;object-fit:cover;border-radius:14px;background:var(--gunmetal);"
              },
              // Removed Porsche Ice Experience 2024 and Volkswagen Tiguan entries
            ];
            let activeIdx = 0;
            let isPlaying = false;
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const playPauseBtn = document.getElementById('playPauseBtn');
            function updateActive(idx) {
              activeIdx = idx;
              const items = document.querySelectorAll('.work-item');
              items.forEach((item, i) => {
                if (i === idx) item.classList.add('active'); else item.classList.remove('active');
              });
              const work = works[idx];
              const preview = document.getElementById('workPreview');
              preview.innerHTML = `
                <div class="hover-media" style="width:100%;">
                  <video id="workVideo" controls style="${work.videoStyle}" poster="">
                    <source src="${work.video}" type="video/mp4" />
                    Your browser does not support the video tag.
                  </video>
                </div>
              `;
              isPlaying = false;
              playPauseBtn.innerHTML = '&#9654;';
            }
            // Restore hover feature
            document.addEventListener('DOMContentLoaded', () => {
              const items = document.querySelectorAll('.work-item');
              items.forEach((item, idx) => {
                item.addEventListener('click', () => {
                  updateActive(idx);
                  // Play the video after it's rendered
                  setTimeout(() => {
                    const video = document.getElementById('workVideo');
                    if (video) {
                      video.play().catch(() => {
                        // autoplay may be blocked; do nothing
                      });
                      playPauseBtn.innerHTML = '&#10073;&#10073;';
                      isPlaying = true;
                    }
                  }, 50);
                });
              });
            });
            prevBtn.onclick = () => {
              updateActive((activeIdx - 1 + works.length) % works.length);
            };
            nextBtn.onclick = () => {
              updateActive((activeIdx + 1) % works.length);
            };
            playPauseBtn.onclick = () => {
              const video = document.getElementById('workVideo');
              if (!video) return;
              if (video.paused) {
                video.play();
                playPauseBtn.innerHTML = '&#10073;&#10073;';
                isPlaying = true;
              } else {
                video.pause();
                playPauseBtn.innerHTML = '&#9654;';
                isPlaying = false;
              }
            // Removed invalid ESM import and call from browser script
          }
        </script>