---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
const title = "Ken Pham | About";
---
<!doctype html>
<html lang="en">
  <head>
      <link rel="stylesheet" href="/styles/main.css" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content="Ken Pham is a director and producer whose latest film, That Which Is Heard will have its World Premiere at DOC NYC 2025" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://www.kenpham.ca/about/" />
    <!-- Plausible Analytics -->
    <script defer data-domain="www.kenpham.ca" src="https://plausible.io/js/script.js"></script>
    
    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content="Ken Pham" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Ken Pham | About" />
    <meta property="og:description" content="Ken Pham is a director and producer whose latest film, That Which Is Heard will have its World Premiere at DOC NYC 2025" />
    <meta property="og:url" content="https://www.kenpham.ca/about" />
    <meta property="og:image" content="https://www.kenpham.ca/images/about-kenpham.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ken Pham | About" />
    <meta name="twitter:description" content="Ken Pham is a director and producer whose latest film, That Which Is Heard will have its World Premiere at DOC NYC 2025" />
    <meta name="twitter:image" content="https://www.kenpham.ca/images/about-kenpham.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Work+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
      /* ...existing code... */
      
      .wrap { 
        max-width:100%; 
        margin:0 auto; 
        padding:32px;
      }
      
      @media (max-width: 768px) {
        .wrap { padding: 24px; }
      }

      .about-content {
        margin-top: 48px;
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 64px;
        align-items: start;
      }

      @media (max-width: 768px) {
        .about-content {
          grid-template-columns: 1fr;
          gap: 48px;
        }
      }

      .about-text {
        font-size: 16px;
        line-height: 1.8;
        color: var(--text-color);
      }

      .about-text p {
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
      }
      
      .about-text p::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--bg-color, #000000);
        z-index: 1;
        animation: textCurtainReveal 0.7s ease forwards;
      }
      
      .about-text p:nth-child(1)::before { animation-delay: 0.1s; }
      .about-text p:nth-child(2)::before { animation-delay: 0.25s; }
      .about-text p:nth-child(3)::before { animation-delay: 0.4s; }
      
      @keyframes textCurtainReveal {
        from { 
          transform: translateX(0);
        }
        to { 
          transform: translateX(100%);
        }
      }

      .press-section {
        margin-top: 48px;
      }

      .press-section h3 {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        margin: 0 0 16px 0;
        color: var(--text-color);
      }

      .press-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .press-list a {
        color: var(--text-secondary, rgba(242, 242, 242, 0.7));
        text-decoration: none;
        font-size: 15px;
        line-height: 1.6;
        transition: color 0.2s ease;
      }

      .press-list a:hover {
        color: var(--text-color);
        text-decoration: underline;
        text-underline-offset: 3px;
      }

      .press-list a:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }

      .press-list .press-source {
        color: var(--text-color);
        font-weight: 600;
      }

      .about-image {
        position: sticky;
        top: 144px;
        overflow: hidden;
        border-radius: 8px;
      }
      
      .about-image::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--bg-color, #000000);
        z-index: 1;
        border-radius: 8px;
        animation: curtainRevealPhoto 0.8s ease forwards 0.2s;
      }
      
      @keyframes curtainRevealPhoto {
        from { 
          transform: translateY(0);
        }
        to { 
          transform: translateY(-100%);
          opacity: 0;
        }
      }

      .about-image img {
        width: 100%;
        height: auto;
        border-radius: 8px;
      }

      @media (max-width: 768px) {
        .about-image {
          position: static;
          order: -1;
        }
      }

      .skip-link {
        position: absolute;
        left: -999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
      }
      .skip-link:focus {
        position: fixed;
        left: 16px;
        top: 16px;
        width: auto;
        height: auto;
        padding: 10px 14px;
        background: #fff;
        color: #000;
        border-radius: 4px;
        z-index: 100;
        text-decoration: none;
        border: 1px solid #0002;
        box-shadow: 0 2px 8px #0006;
      }
      
      /* View Transitions API */
      @view-transition {
        navigation: auto;
      }
      
      ::view-transition-old(root) {
        animation: fadeOut 0.3s ease;
      }
      
      ::view-transition-new(root) {
        animation: fadeIn 0.3s ease;
        background: var(--bg-color, #000000);
      }
      
      @keyframes fadeOut {
        to { opacity: 0; }
      }
      
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="wrap">
      <SiteHeader />

      <main id="main-content" class="about-content">
        <div class="about-text">
          <section>
            <p>
              Ken Pham is a director whose artistic roots began with movement. He spent years as a choreographer and dancer on productions including Star Trek: Strange New Worlds, SEE (Apple TV+), What We Do in the Shadows, and The Magicians.
            </p>
            <p>
              His practice spans narrative, documentary, commercial, and mixed media. He directs campaigns for Porsche, Toyota, Volkswagen, and the Michelin Guide, and honed his approach to storytelling while assisting the director and producer of The Changeling (Apple TV+) and shadowing director Jason Eisener on Dark Side of the Ring.
            </p>
            <p>
              His documentary That Which Is Heard, following a stroke survivor's return to the stage, had its World Premiere at DOC NYC 2025, North America's largest documentary festival. His debut short film, The Hall Pass, screened at the 2025 Toronto Short Film Festival and was a Finalist at Canada Shorts.
            </p>
          </section>

          <section class="press-section" aria-labelledby="press-heading">
            <h3 id="press-heading">PRESS</h3>
            <ul class="press-list">
              <li>
                <a href="https://variety.com/2025/film/news/doc-nyc-film-lineup-1236541355/" target="_blank" rel="noopener noreferrer">
                  <span class="press-source">Variety</span> DOC NYC Unveils 16th Annual Film Lineup (Exclusive)
                </a>
              </li>
              <li>
                <a href="https://www.reelworld.ca/reelworld-directors-immersion-program" target="_blank" rel="noopener noreferrer">
                  <span class="press-source">Reelworld</span> Directors Immersion Program in Partnership with NBCUniversal
                </a>
              </li>
              <li>
                <a href="https://thecma.ca/awards/2025-winner" target="_blank" rel="noopener noreferrer">
                  <span class="press-source">Canadian Marketing Awards</span> 2025 Gold for Engagement, Porsche Cayenne Taste Drive
                </a>
              </li>
              <li>
                <a href="https://thecma.ca/awards/2025-winner" target="_blank" rel="noopener noreferrer">
                  <span class="press-source">Canadian Marketing Awards</span> 2025 Gold for Customer Experience &amp; Shopper Marketing, Porsche Cayenne Taste Drive
                </a>
              </li>
            </ul>
          </section>
        </div>

        <div class="about-image">
          <img src="/images/about-kenpham.webp" alt="Ken Pham" width="2033" height="2544" loading="lazy" />
        </div>
      </main>
      
      <SiteFooter />
    </div>

    <button id="backToTop" aria-label="Back to top" tabindex="0" style="display:none;position:fixed;bottom:32px;right:32px;z-index:200;background:#000000cc;color:#fff;border:none;border-radius:50%;width:48px;height:48px;box-shadow:0 2px 12px #0007;cursor:pointer;transition:opacity 0.2s;outline:none;font-size:24px;align-items:center;justify-content:center;">
      ↑
    </button>
    <style>
      #backToTop:focus { outline: 2px solid #fff; }
      #backToTop[hidden] { display: none !important; }
    </style>
    <script type="module">
      import { initBackToTop } from '/scripts/shared.js';
      initBackToTop();
    </script>
  </body>
</html>
